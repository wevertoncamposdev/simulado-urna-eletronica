# Porta em que a API escuta. Railway injeta PORT automaticamente — não defina
# manualmente lá, só em desenvolvimento local se quiser outra porta além de 3000.
PORT=3000

# Interface de rede. Em produção (NODE_ENV=production) o padrão já vira 0.0.0.0
# (necessário para funcionar dentro de um container); só sobrescreva se souber o motivo.
HOST=localhost

# Segredo usado para assinar os tokens JWT (HS256). OBRIGATÓRIO em produção — o
# servidor recusa iniciar sem ele quando NODE_ENV=production. Gere um valor aleatório
# forte, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origem(ns) do frontend liberadas no CORS, separadas por vírgula (sem espaço ou com,
# são aparados automaticamente). Em produção, aponte para a URL pública do frontend.
FRONTEND_URL=http://localhost:5173

# Diretório onde ficam os arquivos *.json (dados) e /photos (fotos de candidatos).
# Em produção, aponte para um volume persistente (ex.: no Railway, monte um Volume em
# /app/data e defina DATA_PATH=/app/data) — sem isso, os dados somem a cada deploy.
DATA_PATH=./data

# Marca o ambiente como produção: ativa validações estritas (JWT_SECRET obrigatório,
# HOST padrão 0.0.0.0). Definido automaticamente no Dockerfile — normalmente não
# precisa ser setado à mão.
NODE_ENV=development
